# Copy to .env for local development. NEVER commit .env
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# SAML 2.0 SSO (replaces OIDC/Entra). Leave SAML_* empty to disable SSO.
# Entry point = IdP SSO URL; Issuer = this app's entity ID; idpCert = IdP X.509 cert (validation stays enabled)
SAML_ENTRY_POINT=
SAML_ISSUER=appsec-test-lab
SAML_CALLBACK_URL=
SAML_IDP_CERT=
SAML_IDP_ISSUER=
SAML_IDENTIFIER_FORMAT=
SAML_WANT_RESPONSE_SIGNED=false
SAML_EMAIL_ATTRIBUTE=
SAML_NAME_ATTRIBUTE=

# Session signing secret (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=replace-me-local-only

# Demo administrator identity (used for /admin authorization + SAML role mapping)
ADMIN_EMAIL=dast-admin@example.com

# Local authentication (synthetic lab users — set real secrets via Render env vars or local .env, never commit)
LOCAL_AUTH_ENABLED=true
LOCAL_USER_PASSWORD=replace-me-lab-only
LOCAL_ADMIN_PASSWORD=replace-me-lab-only
