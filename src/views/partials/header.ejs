<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AppSec Test Lab — Security Learning Environment</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="ambient-glow"></div>
<div class="ambient-glow-2"></div>

<div class="safe-sandbox-banner">
<div class="notice">
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
<span>Isolated Sandbox Environment — Synthetic data only. Safe for vulnerability analysis.</span>
</div>
<div class="tag-build">Lab <%= appVersion %> · OWASP Top 10 Suite</div>
</div>

<header class="site-header">
<div class="brand-group">
<div class="logo-icon">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
</div>
<div class="brand-text">
<h1>AppSec Test Lab <span class="brand-badge">Active Sandbox</span></h1>
</div>
</div>
<div class="nav-actions">
<a href="/" class="nav-link <%= currentPath === '/' ? 'current' : '' %>">Overview</a>
<a href="/security-lab" class="nav-link <%= currentPath === '/security-lab' ? 'current' : '' %>">Documentation</a>
<% if (user) { %>
<span style="color:var(--text-muted); font-size:13px;"><%= user.email %> · <%= user.authMethod === 'local' ? 'local' : 'saml' %></span>
<a href="/dashboard" class="nav-link <%= currentPath === '/dashboard' ? 'current' : '' %>">Dashboard</a>
<a href="/logout" class="btn-auth">Logout</a>
<% } else { %>
<a href="/login" class="btn-auth">
<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
Sign in
</a>
<% } %>
</div>
</header>

<main class="container">
